# Copy to .env.local for local development. Never commit real values.
# On your host, add the same names in its environment-variable settings.
# Every variable is optional — the site builds without any of them.

# GitHub token for repository data (stars, languages, last push, releases).
# Without it the anonymous limit is 60 requests/hour, which shared build
# machines can exhaust. Create a fine-grained token with
# "Public repositories (read-only)" access and no other permissions:
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# YouTube Data API v3 key. Adds publish date + duration (used for
# VideoObject structured data) and lets `npm run audit:sources` list every
# upload instead of only the latest ~15. Restrict it to the YouTube Data API.
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Your host's "deploy hook" / "build hook" URL. Enables the
# "Rebuild live site" button in /admin (local) and the manual
# "Rebuild site" GitHub Action (add it there as a repository secret).
DEPLOY_HOOK_URL=

# Keystatic GitHub mode — only needed to edit content on the LIVE site
# (requires a host that runs Node.js). Keystatic generates these values when
# you create its GitHub App from /keystatic; see CLAUDE.md → CMS.
# Locally, the CMS needs none of them.
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
